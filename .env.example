# Copie para neoson.env e preencha. Nunca versione arquivos com valores reais.
# Precedência: variáveis do processo > neoson.env > valores padrão (os mostrados aqui).
# Linhas vazias ou com valor em branco usam o padrão.

# --- Servidor (lidas por neoson_core.infrastructure.config) ---

# Ambiente: development, test ou production
NEOSON_ENV=development
# DEBUG, INFO, WARNING, ERROR ou CRITICAL
NEOSON_LOG_LEVEL=INFO

# Gateway HTTP. O token é obrigatório: os clientes enviam "Authorization: Bearer <token>".
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(32))"
NEOSON_API_TOKEN=
NEOSON_GATEWAY_HOST=127.0.0.1
NEOSON_GATEWAY_PORT=8000

# Provedor de LLM: openai, ou echo para desenvolver sem chave (devolve o texto recebido)
NEOSON_LLM_PROVIDER=openai
NEOSON_LLM_MODEL=
OPENAI_API_KEY=
# Esforço de raciocínio do modelo (ex.: low, medium, high); em branco usa o padrão do modelo
NEOSON_LLM_REASONING_EFFORT=
# Preços para estimar custo, em USD por milhão de tokens (JSON). Exemplo:
# {"meu-modelo": {"input": 1.25, "output": 10.0, "cached_input": 0.125}}
NEOSON_LLM_PRICES=

# Voz: fake somente com echo fora de produção; disabled mantém a rota desligada.
NEOSON_VOICE_PROVIDER=disabled
NEOSON_VOICE_MAX_BYTES=1048576
NEOSON_VOICE_MAX_SECONDS=15
NEOSON_VOICE_TIMEOUT_SECONDS=30
NEOSON_VOICE_MAX_CONCURRENCY=1

# Calendário/e-mail: disabled, fake (fora de produção), ou microsoft por escolha explícita.
# Apenas dados básicos da agenda e metadados do inbox, sem corpo/anexos/escritas.
NEOSON_PERSONAL_PROVIDER=disabled
NEOSON_MICROSOFT_CLIENT_ID=
NEOSON_MICROSOFT_TENANT=consumers
# Cache local: DPAPI no Windows; arquivo `0600` no POSIX. Não copiar para outro usuário.
NEOSON_MICROSOFT_TOKEN_PATH=./data/credentials/microsoft.bin
# Escritas limitadas: disabled, fake (sandbox local), microsoft (consentimento separado).
NEOSON_PERSONAL_WRITE_PROVIDER=disabled
NEOSON_MICROSOFT_WRITE_TOKEN_PATH=./data/credentials/microsoft-write.bin
NEOSON_PERSONAL_SANDBOX_DB_PATH=./data/personal-sandbox.db

# Persistência
NEOSON_DB_PATH=./data/neoson.db
# Evidências do Router Lab, separadas das conversas; o painel lê sem criar/migrar.
NEOSON_ROUTER_LAB_DB_PATH=./data/router-lab.db
NEOSON_VAULT_PATH=./data/NeoSon-Vault
# Pasta dos backups criados por neoson-backup (fora do Git)
NEOSON_BACKUP_PATH=./data/backups
# Biblioteca de skills (SKILL.md + metadata.yaml por pasta), versionada no Git
NEOSON_SKILLS_PATH=./skill_library

# Roteamento e execução
NEOSON_PRIMARY_MODEL_PROFILE=balanced
NEOSON_ROUTER_POLICY=rules-v1
# Inteiro >= 1
NEOSON_MAX_AGENT_STEPS=12
# Mensagens anteriores da sessão enviadas ao modelo (inteiro >= 1)
NEOSON_HISTORY_MAX_MESSAGES=40
# Fatos da memória curada incluídos no prompt (inteiro >= 1)
NEOSON_MEMORY_MAX_FACTS=30
# Tempo máximo de uma execução, em segundos (> 0)
NEOSON_RUN_TIMEOUT_SECONDS=120
# Análises delegadas por execução (inteiro >= 0; >= 1 quando a delegação está ligada)
NEOSON_MAX_SUBAGENTS=2
# Delegação interna sem ferramentas, com só a tarefa e o trecho escolhidos pelo modelo
# (desligada por padrão; ver docs/runbooks/delegation.md)
NEOSON_DELEGATION_ENABLED=false
# Prazo de cada análise delegada, em segundos (0 < x <= 120)
NEOSON_DELEGATION_TIMEOUT_SECONDS=15
# Tokens somados de todas as análises delegadas de uma execução (1 a 200000)
NEOSON_DELEGATION_MAX_TOKENS=16000
# Teto de saída de cada análise delegada (menor que o total acima)
NEOSON_DELEGATION_MAX_OUTPUT_TOKENS=1000
# Aprovação de ferramentas: required_for_sensitive (escrita sensível pede aprovação) ou always
NEOSON_APPROVAL_MODE=required_for_sensitive
# Fuso horário IANA do usuário (data de hoje no prompt e na agenda)
NEOSON_TIMEZONE=America/Sao_Paulo

# Worker da outbox: intervalo entre consultas, duração do lease e tentativas antes do dead letter
NEOSON_WORKER_POLL_SECONDS=1.0
NEOSON_WORKER_LEASE_SECONDS=60.0
NEOSON_WORKER_MAX_ATTEMPTS=5

# Curadoria opcional: worker agenda; neoson-curator gera propostas sem ativá-las.
NEOSON_CURATION_ENABLED=false
NEOSON_CURATION_TIMEOUT_SECONDS=30
NEOSON_CURATION_MAX_ATTEMPTS=3
NEOSON_CURATION_MAX_DAILY_JOBS=5
NEOSON_CURATION_MAX_DAILY_TOKENS=60000
NEOSON_CURATION_MAX_INPUT_CHARS=12000
NEOSON_CURATION_MAX_OUTPUT_TOKENS=3000
# Teto USD opcional; exige preços em NEOSON_LLM_PRICES, inclusive para reservas.
NEOSON_CURATION_MAX_DAILY_COST_USD=

# Recursos opcionais (true ou false)
# Grafo de conhecimento com proveniência (ADR-014/015). Ligado, o worker enfileira a
# extração das memórias salvas e `neoson-graph run` chama o modelo; os fatos ficam
# pendentes até a revisão (docs/runbooks/knowledge-graph.md)
NEOSON_MEMORY_GRAPH_ENABLED=false
NEOSON_GRAPH_EXTRACTION_TIMEOUT_SECONDS=30
NEOSON_GRAPH_EXTRACTION_MAX_ATTEMPTS=3
NEOSON_GRAPH_EXTRACTION_MAX_DAILY_JOBS=20
NEOSON_GRAPH_EXTRACTION_MAX_DAILY_TOKENS=40000
NEOSON_GRAPH_EXTRACTION_MAX_INPUT_CHARS=4000
NEOSON_GRAPH_EXTRACTION_MAX_OUTPUT_TOKENS=1500
# Fatos aproveitados por memória (1 a 50)
NEOSON_GRAPH_EXTRACTION_MAX_FACTS=10
# Teto USD opcional; exige preços em NEOSON_LLM_PRICES, inclusive para reservas.
NEOSON_GRAPH_EXTRACTION_MAX_DAILY_COST_USD=
NEOSON_METRICS_EXPORT_ENABLED=true

# Telegram (neoson-telegram): token do bot (@BotFather) e IDs numéricos dos usuários
# permitidos, separados por vírgula. Mensagens de outros remetentes são ignoradas.
NEOSON_TELEGRAM_BOT_TOKEN=
NEOSON_TELEGRAM_ALLOWED_USERS=

# --- Fora do servidor (ignoradas pela configuração do servidor) ---

# Robô (neoson-robot): endereço do gateway e o mesmo NEOSON_API_TOKEN do servidor
# (variáveis do processo). Na Pi, o endereço é o do notebook servidor,
# por exemplo http://neoson-servidor.local:8000. A opção --gateway-url tem precedência.
NEOSON_GATEWAY_URL=http://127.0.0.1:8000

# Raspberry Pi (NeoSon Robot): acesso e deploy
NEOSON_PI_HOST=neoson-pi.local
NEOSON_PI_USER=neoson
