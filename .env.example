# Copie para neoson.env e preencha. Nunca versione arquivos com valores reais.
# Precedência: variáveis do processo > neoson.env > valores padrão (os mostrados aqui).
# Linhas vazias ou com valor em branco usam o padrão.

# --- Servidor (lidas por neoson_core.infrastructure.config) ---

# Ambiente: development, test ou production
NEOSON_ENV=development
# DEBUG, INFO, WARNING, ERROR ou CRITICAL
NEOSON_LOG_LEVEL=INFO

# Gateway HTTP. O token é obrigatório: os clientes enviam "Authorization: Bearer <token>".
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(32))"
NEOSON_API_TOKEN=
NEOSON_GATEWAY_HOST=127.0.0.1
NEOSON_GATEWAY_PORT=8000

# Provedor de LLM: openai, ou echo para desenvolver sem chave (devolve o texto recebido)
NEOSON_LLM_PROVIDER=openai
NEOSON_LLM_MODEL=
OPENAI_API_KEY=
# Esforço de raciocínio do modelo (ex.: low, medium, high); em branco usa o padrão do modelo
NEOSON_LLM_REASONING_EFFORT=
# Preços para estimar custo, em USD por milhão de tokens (JSON). Exemplo:
# {"meu-modelo": {"input": 1.25, "output": 10.0, "cached_input": 0.125}}
NEOSON_LLM_PRICES=

# Persistência
NEOSON_DB_PATH=./data/neoson.db
NEOSON_VAULT_PATH=./data/NeoSon-Vault

# Roteamento e execução
NEOSON_PRIMARY_MODEL_PROFILE=balanced
NEOSON_ROUTER_POLICY=rules-v1
# Inteiro >= 1
NEOSON_MAX_AGENT_STEPS=12
# Mensagens anteriores da sessão enviadas ao modelo (inteiro >= 1)
NEOSON_HISTORY_MAX_MESSAGES=40
# Tempo máximo de uma execução, em segundos (> 0)
NEOSON_RUN_TIMEOUT_SECONDS=120
# Inteiro >= 0
NEOSON_MAX_SUBAGENTS=2
# Aprovação de ferramentas: required_for_sensitive (escrita sensível pede aprovação) ou always
NEOSON_APPROVAL_MODE=required_for_sensitive
# Fuso horário IANA do usuário (data de hoje no prompt e na agenda)
NEOSON_TIMEZONE=America/Sao_Paulo

# Worker da outbox: intervalo entre consultas, duração do lease e tentativas antes do dead letter
NEOSON_WORKER_POLL_SECONDS=1.0
NEOSON_WORKER_LEASE_SECONDS=60.0
NEOSON_WORKER_MAX_ATTEMPTS=5

# Recursos opcionais (true ou false)
NEOSON_MEMORY_GRAPH_ENABLED=false
NEOSON_METRICS_EXPORT_ENABLED=true

# Telegram (neoson-telegram): token do bot (@BotFather) e IDs numéricos dos usuários
# permitidos, separados por vírgula. Mensagens de outros remetentes são ignoradas.
NEOSON_TELEGRAM_BOT_TOKEN=
NEOSON_TELEGRAM_ALLOWED_USERS=

# --- Fora do servidor (ignoradas pela configuração do servidor) ---

# Robô (neoson-robot): endereço do gateway e o mesmo NEOSON_API_TOKEN do servidor
# (variáveis do processo). Na Pi, o endereço é o do notebook servidor,
# por exemplo http://neoson-servidor.local:8000. A opção --gateway-url tem precedência.
NEOSON_GATEWAY_URL=http://127.0.0.1:8000

# Raspberry Pi (NeoSon Robot): acesso e deploy
NEOSON_PI_HOST=neoson-pi.local
NEOSON_PI_USER=neoson
